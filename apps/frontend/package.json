{
  "name": "frontend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "test:types": "nuxt typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "dotenvx run -f ../../.env -- playwright test",
    "quickcheck": "pnpm run lint && pnpm run test:types && pnpm run test",
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "build:workerdLocal": "export TARGET=workerdLocal && nuxt generate",
    "deploy": "pnpm run build && sh scripts/deploy.sh",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@unocss/reset": "catalog:",
    "embla-carousel": "catalog:",
    "embla-carousel-vue": "catalog:",
    "lenis": "catalog:",
    "lucide-vue-next": "catalog:",
    "reka-ui": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@local/common": "workspace:*",
    "@local/common-vue": "workspace:*",
    "@local/locales": "workspace:*",
    "@local/nuxt-layer-common": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@namesmt/utils": "catalog:",
    "@nuxt/eslint": "catalog:",
    "@playwright/test": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/integrations": "catalog:",
    "ai": "catalog:",
    "backend": "workspace:*",
    "backend-convex": "workspace:*",
    "convex": "catalog:",
    "convex-vue": "catalog:",
    "destr": "catalog:",
    "dotenv": "catalog:",
    "happy-dom": "catalog:",
    "kontroll": "catalog:",
    "nuxt": "catalog:",
    "unocss": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
